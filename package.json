{
	"name": "drizzle-schema-checker",
	"version": "1.2.4",
	"description": "Checks if a Drizzle schema is also valid in a database",
	"type": "module",
	"repository": "github:adrienZ/drizzle-schema-checker",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts --clean",
		"dev": "vitest",
		"prepack": "pnpm run build",
		"test": "vitest run",
		"test:types": "tsc --noEmit",
		"test:bun": "bun test ./tests/bun-sqlite.test.bun.ts",
		"test:ci": "pnpm test -- --coverage --coverage.provider istanbul --reporter=default --reporter=junit --outputFile=./junit.xml && pnpm test:bun",
		"lint": "biome lint",
		"format": "biome format --write",
		"release": "npm run test:types && npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags"
	},
	"keywords": [
		"drizzle",
		"database",
		"validation",
		"schema"
	],
	"author": "Adrien Zaganelli",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@cloudflare/vitest-pool-workers": "^0.8.71",
		"@vitest/coverage-istanbul": "^3.1.1",
		"db0": "^0.3.1",
		"pkg-pr-new": "^0.0.42",
		"tsup": "^8.4.0",
		"typescript": "^5.8.2",
		"vitest": "^3.1.1",
		"wrangler": "^4.6.0"
	},
	"dependencies": {
		"@libsql/client": "^0.15.2",
		"better-sqlite3": "^11.9.1",
		"changelogen": "^0.6.1",
		"consola": "^3.4.2",
		"drizzle-orm": "^0.45.2",
		"zod": "^3.24.2"
	},
	"packageManager": "pnpm@9.10.0",
	"pnpm": {
		"overrides": {
			"tar-fs": ">=2.1.2"
		}
	}
}
